<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Recipe_book"
             x:Class="Recipe_book.App"
             xmlns:converters="clr-namespace:Recipe_book.Helpers.Converters"
           >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!--Convertors-->
            <converters:BoolToColorConverter x:Key="BoolToColor" />
            <converters:BoolToVis x:Key="BoolToVis"/>
            <converters:BlackOrWhiteConverter x:Key="BlackOrWhiteConverter" />
            <converters:RatingToStarImageConverter x:Key="RatingToStarImageConverter"/>
            <converters:ScreenRatioConverter x:Key="ScreenRatioConverter"/>


        </ResourceDictionary>
    </Application.Resources>
</Application>
