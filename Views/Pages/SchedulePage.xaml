<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Recipe_book.ViewModels"
             x:Class="Recipe_book.Views.Pages.SchedulePage"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, Auto, *" BackgroundColor="#F5F5F5">

        <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Margin="0,0,0,5" ZIndex="5">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="6" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15" Padding="20,15,20,15">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <Label Grid.Column="0" Text="הלוז שלי" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" VerticalOptions="Center" />

                    <Button Grid.Column="1" 
                            Text="היום" 
                            Clicked="OnGoToTodayClicked"
                            BackgroundColor="#F0F4F8" 
                            TextColor="{StaticResource Primary}" 
                            FontAttributes="Bold" 
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="35"
                            Padding="12,0"
                            Margin="0,0,10,0"
                            VerticalOptions="Center" 
                           />

                    <Grid Grid.Column="2" WidthRequest="35" HeightRequest="35" VerticalOptions="Center">
                        <Image Source="calendar_main_icon.svg" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <DatePicker x:Name="HiddenDatePicker" Date="{Binding SelectedDatePickerDate}" Opacity="0.02" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    </Grid>
                </Grid>

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <ImageButton Grid.Column="0" Command="{Binding PreviousWeekCommand}" 
                                 Source="caret_down_icon.svg" Rotation="-90"
                                 WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" VerticalOptions="Center" />

                    <Label Grid.Column="1" Text="{Binding WeekDateRangeText}" 
                           FontSize="16" FontAttributes="Bold" TextColor="#555555" 
                           HorizontalOptions="Center" VerticalOptions="Center"/>

                    <ImageButton Grid.Column="2" Command="{Binding NextWeekCommand}" 
                                 Source="caret_down_icon.svg" Rotation="90"
                                 WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" VerticalOptions="Center" />
                </Grid>

                <CollectionView x:Name="DaysCollectionView" 
                                ItemsSource="{Binding WeekDays}" 
                                SelectedItem="{Binding SelectedDay}" 
                                SelectionMode="Single" 
                                HeightRequest="90" 
                                Margin="-20,5,-20,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 16" WidthRequest="64" HeightRequest="80" StrokeThickness="0" Margin="2,2,2,4">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,3" Opacity="0.06" Radius="4" />
                                </Border.Shadow>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="White" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="{Binding DayName}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" 
                                           TextColor="{Binding Source={RelativeSource AncestorType={x:Type Border}}, Path=BackgroundColor, Converter={StaticResource BlackOrWhiteConverter}, FallbackValue=Black}"/>
                                    <Label Text="{Binding DateString}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" 
                                           TextColor="{Binding Source={RelativeSource AncestorType={x:Type Border}}, Path=BackgroundColor, Converter={StaticResource BlackOrWhiteConverter}, FallbackValue=Gray}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="20,15,20,0">

            <Grid Grid.Row="0" Margin="0,0,0,15" ColumnDefinitions="*, Auto, Auto">
                <Label Grid.Column="0" Text="{Binding SelectedDay.DayName, StringFormat='ארוחות יום {0}'}" 
                       FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>

                <Button Grid.Column="1" Text="סגור/פתח הכל" 
                        BackgroundColor="Transparent" TextColor="Gray" 
                        FontSize="12" FontAttributes="Bold" Padding="10,0" Margin="0,0,10,0"
                        VerticalOptions="Center"
                        Command="{Binding ToggleAllMealsCommand}"/>

                <ImageButton Grid.Column="2" Source="pencil_light_withline_icon.svg"
                             WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"
                             Command="{Binding EditDayMealsCommand}" />
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedDay.MealGroups}" Spacing="18" Padding="0,0,0,30">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="0">
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White" Padding="15,12" Margin="0,0,0,10">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Opacity="0.05" Radius="4" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ToggleMealGroupCommand}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Image Grid.Column="0" Source="caret_down_icon.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Margin="0,0,10,0">
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image" Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Rotation" Value="180" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <Label Grid.Column="1" Text="{Binding GroupName}" FontSize="18" FontAttributes="Bold" TextColor="#2B3A42" VerticalOptions="Center"/>

                                        <Button Grid.Column="2" Text="הוסף +" 
                                                HeightRequest="32" CornerRadius="16" 
                                                BackgroundColor="#F0F4F8" TextColor="{StaticResource Primary}" 
                                                FontAttributes="Bold" FontSize="12" Padding="12,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.AddRecipeToMealCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Border>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Meals}" Spacing="8" Margin="15,0,5,15" IsVisible="{Binding IsExpanded}">
                                    <BindableLayout.EmptyView>
                                        <Label Text="אין מתכונים מתוכננים" TextColor="DarkGray" FontSize="13" HorizontalOptions="Center" Margin="0,5"/>
                                    </BindableLayout.EmptyView>

                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeShape="RoundRectangle 8" Stroke="#EEEEEE" StrokeThickness="1" BackgroundColor="White" Padding="12,10">
                                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                                    <Label Grid.Column="0" Text="{Binding RecipeDetails.Title}" 
                                                           FontSize="15" TextColor="#444444" FontAttributes="Bold"
                                                           VerticalOptions="Center" LineBreakMode="TailTruncation">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer 
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.ViewRecipeCommand}"
                                                                CommandParameter="{Binding RecipeDetails}"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>

                                                    <ImageButton Grid.Column="1" Source="minus_icon.svg"
                                                                 WidthRequest="20" HeightRequest="20" 
                                                                 BackgroundColor="Transparent"
                                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.RemoveRecipeCommand}"
                                                                 CommandParameter="{Binding .}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>