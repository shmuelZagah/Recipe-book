<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Recipe_book.ViewModels"
             xmlns:items ="clr-namespace:Recipe_book.Views.Items"
             x:Class="Recipe_book.Views.Pages.ShoppingListPage"
             xmlns:popups="clr-namespace:Recipe_book.Views.Items.Popups"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid BackgroundColor="#F5F5F5" RowDefinitions="Auto, *">

            <!-- כותרת עליונה -->
            <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Margin="0,0,0,5" ZIndex="5">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Opacity="0.05" Radius="6" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*, Auto" Padding="15,12,20,12" VerticalOptions="Center">

                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" HorizontalOptions="Start">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleListsMenuCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>

                            <Label Text="{Binding CurrentShoppingList.Title}" 
                               Style="{StaticResource SubHeadline}" 
                               FontSize="18"
                               TextColor="Black"
                               HorizontalOptions="Start" 
                               VerticalOptions="Center" />

                            <Image x:Name="CaretIcon"
                               Source="caret_down_icon.svg" 
                               WidthRequest="14" 
                               HeightRequest="14" 
                               VerticalOptions="Center" 
                               Margin="0,2,0,0" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding StatusText}" 
                           TextColor="Gray" 
                           FontSize="12" 
                           HorizontalOptions="Start" />
                    </VerticalStackLayout>

                    <ImageButton Grid.Column="1" 
                             Source="share_icon.svg" 
                             Command="{Binding ShareListCommand}" 
                             WidthRequest="30" HeightRequest="30" 
                             BackgroundColor="Transparent"/>
                </Grid>
            </Border>

            <!-- תוכן מרכזי -->
            <Grid Grid.Row="1">

                <Grid RowDefinitions="Auto, *">

                    <!-- סרגל כלים: הסר פריטים -->
                    <Grid Grid.Row="0" Padding="20,10,20,5" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="1" 
                           HorizontalOptions="End" 
                           Text="הסר פריטים שסומנו" 
                           TextColor="{StaticResource Primary}" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           IsVisible="{Binding HasValidList}"
                           VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearBoughtItemsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- רשימת הקניות -->
                    <CollectionView Grid.Row="1" ItemsSource="{Binding GroupedShoppingItems}" IsGrouped="True" Margin="20,0,20,0">
                        <CollectionView.Triggers>
                            <DataTrigger TargetType="CollectionView" Binding="{Binding IsHeaderOpen}" Value="True">
                                <Setter Property="Opacity" Value="0.2" />
                                <Setter Property="InputTransparent" Value="True" />
                            </DataTrigger>
                        </CollectionView.Triggers>

                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate>
                                <Label Text="{Binding CategoryName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" Margin="0,10,0,10" />
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>

                        <!-- תבנית המצרך הבודד -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10,5" Margin="0,5" CornerRadius="8" HasShadow="False" BorderColor="#EEEEEE" BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto, *, Auto">

                                        <!-- צ'קבוקס -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsBought}" Color="{StaticResource Primary}" VerticalOptions="Center"/>

                                        <!-- שם המצרך -->
                                        <Label Grid.Column="1" Text="{Binding DisplayText}" VerticalOptions="Center" FontSize="16" TextColor="Black" Margin="15,0">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsBought}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="LightGray" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- כפתור העריכה החדש -->
                                        <ImageButton Grid.Column="2" 
                                                     Source="pencil_light_withline_icon.svg"
                                                     WidthRequest="22" HeightRequest="22" 
                                                     VerticalOptions="Center"
                                                     BackgroundColor="Transparent"
                                                     Opacity="0.4"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShoppingListViewModel}}, Path=EditItemDisplayCommand}"
                                                     CommandParameter="{Binding .}" />

                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <Label Text="{Binding EmptyViewText}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" FontSize="16" Margin="30" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Grid>

                <!-- תפריט משיכה מתפריט (Header Dropdown) -->
                <Border IsVisible="{Binding IsHeaderOpen}" 
                    Padding="15,20" 
                    StrokeShape="RoundRectangle 12" 
                    BackgroundColor="White" 
                    StrokeThickness="1" 
                    Stroke="#E8E8E8" 
                    Margin="20,10,20,15" 
                    VerticalOptions="Fill" 
                    ZIndex="10">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,6" Opacity="0.1" Radius="10" />
                    </Border.Shadow>

                    <ScrollView>
                        <VerticalStackLayout Spacing="15">
                            <Label Text="בחר תאריכים למשיכת מצרכים מהלוז" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />

                            <Button Text="רשימה ריקה (ידנית בלבד)" 
                                Command="{Binding ToggleEmptyListModeCommand}"
                                BackgroundColor="#F0F0F0" 
                                TextColor="Gray" 
                                CornerRadius="8" 
                                HeightRequest="45" 
                                FontAttributes="Bold">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsEmptyListTemp}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                            <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                                <FlexLayout.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="BackgroundColor" Value="#F0F0F0"/>
                                        <Setter Property="TextColor" Value="Gray"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="HeightRequest" Value="45"/>
                                        <Setter Property="Padding" Value="15,0"/>
                                        <Setter Property="Margin" Value="5"/>
                                        <Setter Property="FontAttributes" Value="Bold"/>
                                    </Style>
                                </FlexLayout.Resources>

                                <Button Text="יום אחד" Command="{Binding SelectRangeTypeCommand}" CommandParameter="Day">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="Day">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="השבוע" Command="{Binding SelectRangeTypeCommand}" CommandParameter="Week">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="Week">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="שבועיים" Command="{Binding SelectRangeTypeCommand}" CommandParameter="TwoWeeks">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="TwoWeeks">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="שבוע הבא" Command="{Binding SelectRangeTypeCommand}" CommandParameter="NextWeek">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="NextWeek">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="חודש" Command="{Binding SelectRangeTypeCommand}" CommandParameter="Month">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="Month">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="אחר..." Command="{Binding SelectRangeTypeCommand}" CommandParameter="CustomRolling">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="CustomRolling">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </FlexLayout>

                            <VerticalStackLayout IsVisible="{Binding IsCustomRollingVisible}" Spacing="10" Margin="0,5">
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="התחל מעוד:" VerticalOptions="Center" TextColor="Gray" FontAttributes="Bold"/>
                                    <Entry Grid.Column="1" Text="{Binding CustomOffsetDays}" Keyboard="Numeric" HorizontalTextAlignment="Center" Margin="10,0"/>
                                    <Label Grid.Column="2" Text="ימים" VerticalOptions="Center" TextColor="Gray"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="למשך:" VerticalOptions="Center" TextColor="Gray" FontAttributes="Bold"/>
                                    <Entry Grid.Column="1" Text="{Binding CustomDurationDays}" Keyboard="Numeric" HorizontalTextAlignment="Center" Margin="10,0"/>
                                    <Label Grid.Column="2" Text="ימים" VerticalOptions="Center" TextColor="Gray"/>
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>
                            <Label Text="--- או ---" HorizontalOptions="Center" TextColor="LightGray" FontSize="14"/>
                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                            <Label Text="תאריכים ספציפיים" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />

                            <Button Text="בחר תאריכים" 
                                ImageSource="calendar_main_icon.svg"
                                ContentLayout="Right, 8"
                                Command="{Binding SelectRangeTypeCommand}" 
                                CommandParameter="SpecificDates" 
                                BackgroundColor="#F0F0F0" 
                                TextColor="Gray" 
                                CornerRadius="8" 
                                HeightRequest="45" 
                                Margin="20,0" 
                                FontAttributes="Bold">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="SpecificDates">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Grid IsVisible="{Binding IsSpecificDatesVisible}" ColumnDefinitions="*, Auto, *" ColumnSpacing="10" Margin="0,10,0,0">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="מאת:" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                    <DatePicker Date="{Binding SpecificStartDate}" Format="dd/MM/yyyy" TextColor="Black" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="-" VerticalOptions="Center" FontSize="20" TextColor="Gray"/>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="עד:" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                    <DatePicker Date="{Binding SpecificEndDate}" Format="dd/MM/yyyy" TextColor="Black" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                                <Button Grid.Column="0" Text="ביטול" Command="{Binding CancelSelectionCommand}" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
                                <Button Grid.Column="1" Text="יצירת רשימה" Command="{Binding ApplyAndCloseCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <!-- מסך מיזוג רשימות -->
                <Grid BackgroundColor="#99000000" IsVisible="{Binding IsMergeModeActive}" ZIndex="20">
                    <Frame VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320" MaximumHeightRequest="450" CornerRadius="15" Padding="20">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="מיזוג רשימות" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                            <Label Text="סמן את הרשימות שברצונך לאחד:" TextColor="Gray" FontSize="14" HorizontalOptions="Center"/>

                            <ScrollView MaximumHeightRequest="250">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding MergeableLists}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <HorizontalStackLayout Spacing="10" Margin="0,5">
                                                <CheckBox IsChecked="{Binding IsSelected}" Color="{StaticResource Primary}" />
                                                <Label Text="{Binding List.Title}" VerticalOptions="Center" FontSize="16" TextColor="Black" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </ScrollView>

                            <Button Text="בצע מיזוג" Command="{Binding ConfirmMergeCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" HeightRequest="45" FontAttributes="Bold" Margin="0,10,0,0"/>
                            <Button Text="ביטול" Command="{Binding CancelMergeCommand}" BackgroundColor="Transparent" TextColor="Gray" HeightRequest="45" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- כפתור פלוס מרחף -->
                <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End" Margin="20,10,20,10" Spacing="15" ZIndex="5">
                    <items:FloatingActionControl 
                    IconSource="add_icon.svg" 
                    ButtonColor="{StaticResource Primary}"
                    ButtonSize="56"
                    IconSize="32"
                    Command="{Binding OpenFreeTextModalCommand}" />
                </VerticalStackLayout>

            </Grid>
        </Grid>

        <!-- חלונית צפה חכמה להוספת מצרך בטקסט חופשי -->
        <Grid BackgroundColor="#99000000" IsVisible="{Binding IsFreeTextModalOpen}" ZIndex="25">
            <Frame VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="340" CornerRadius="15" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="מה תרצה להוסיף?" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                    <Label Text="לדוגמה: 2 קילו עגבניות, חצי חבילת פסטה..." FontSize="12" TextColor="Gray" HorizontalOptions="Center" Margin="0,-5,0,5"/>

                    <Frame Padding="0" CornerRadius="8" BorderColor="#E0E0E0" HasShadow="False" BackgroundColor="#F9F9F9">
                        <Entry x:Name="FreeTextInputEntry"
                               Text="{Binding FreeTextInput}" 
                               Placeholder="הקלד כאן..." 
                               ReturnType="Done" 
                               ReturnCommand="{Binding ConfirmFreeTextAddCommand}"
                               Completed="FreeTextInputEntry_Completed"
                               Margin="10,0" />
                    </Frame>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="ביטול" Command="{Binding CloseFreeTextModalCommand}" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
                        <Button Grid.Column="1" Text="הוסף" Command="{Binding ConfirmFreeTextAddCommand}" Clicked="FreeTextInputEntry_Completed" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <items:LoadingOverlayControl VerticalOptions="Center" IsLoading="{Binding IsLoading}" LoadingText="{Binding LoadingText}" ZIndex="30"/>
        <popups:EditDisplayModalControl ZIndex="26" />
    </Grid>
</ContentView>