<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Recipe_book.ViewModels"
             xmlns:items ="clr-namespace:Recipe_book.Views.Items"
             x:Class="Recipe_book.Views.Pages.ShoppingListPage"
             FlowDirection="RightToLeft">

    <Grid>

        <Grid RowDefinitions="Auto, *">

            <VerticalStackLayout Grid.Row="0" Padding="20,10,20,0">

                <Grid IsVisible="{Binding IsHeaderClosed}" Margin="0,0,0,15" ColumnDefinitions="Auto, Auto, *">
                    <Button Grid.Column="0" Text="נקה סימונים 🗑️" Command="{Binding ClearBoughtItemsCommand}" BackgroundColor="Transparent" TextColor="#FF2E4C" FontAttributes="Bold" Padding="5,0" Margin="0,0,15,0" HeightRequest="35"/>
                    <Button Grid.Column="1" Text="שתף 📤" Command="{Binding ShareListCommand}" BackgroundColor="Transparent" TextColor="#1A73E8" FontAttributes="Bold" Padding="5,0" HeightRequest="35"/>
                </Grid>

                <Button Text="📅 שנה זמנים" 
                        Command="{Binding OpenHeaderCommand}" 
                        IsVisible="{Binding HasValidList}"
                        BackgroundColor="#F0F0F0" 
                        TextColor="#2B3A42" 
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="28"
                        Padding="14,0"
                        HorizontalOptions="End"
                        Margin="0,0,0,15" />

                <Frame BackgroundColor="#E8F4F8" CornerRadius="20" Padding="20,8" HasShadow="False" BorderColor="#B0D4E3" HorizontalOptions="Center" Margin="0,0,0,5">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleListsMenuCommand}" />
                    </Frame.GestureRecognizers>
                    <Frame.Triggers>
                        <DataTrigger TargetType="Frame" Binding="{Binding IsHeaderOpen}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Frame.Triggers>

                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{Binding CurrentShoppingList.Title}" TextColor="#2B3A42" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="▼" TextColor="#2B3A42" FontSize="12" VerticalOptions="Center" Margin="0,2,0,0" />
                    </HorizontalStackLayout>
                </Frame>

                <Label Text="{Binding StatusText}" 
                       IsVisible="{Binding IsHeaderClosed}"
                       TextColor="Gray" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,15" />

                <Frame IsVisible="{Binding IsListsMenuOpen}" Padding="15" CornerRadius="12" BackgroundColor="#F8F9FA" BorderColor="#DDDDDD" HasShadow="True" Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="הרשימות שלי" FontAttributes="Bold" FontSize="16" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,10"/>

                        <CollectionView ItemsSource="{Binding SavedLists}" MaximumHeightRequest="250">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="15,10" Margin="0,5" CornerRadius="8" BackgroundColor="White" BorderColor="#EEEEEE" HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShoppingListViewModel}}, Path=SwitchListCommand}" CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="📌" VerticalOptions="Center" FontSize="18">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsStatic}" Value="False">
                                                        <Setter Property="Text" Value="🔄" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" FontAttributes="Bold"
                                                   TextColor="#2B3A42" VerticalOptions="Center" Margin="10,0" />

                                            <Frame Grid.Column="2" BackgroundColor="Transparent" CornerRadius="15" 
                                                   Padding="0" HeightRequest="24" WidthRequest="24" HasShadow="False" Margin="0,0,8,0">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShoppingListViewModel}}, Path=RenameListCommand}" CommandParameter="{Binding .}" />
                                                </Frame.GestureRecognizers>
                                                <Label Text="✏" TextColor="Gray" FontSize="14"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Frame>

                                            <Frame Grid.Column="3" BackgroundColor="Transparent" CornerRadius="15" 
                                                   Padding="0" HeightRequest="24" WidthRequest="24" HasShadow="False">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShoppingListViewModel}}, Path=DeleteListCommand}" CommandParameter="{Binding .}" />
                                                </Frame.GestureRecognizers>
                                                <Label Text="➖" TextColor="Black" FontSize="12"
                                                       HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,1"/>
                                            </Frame>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="+ צור רשימה חדשה" Command="{Binding CreateNewListCommand}" BackgroundColor="#2B3A42" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Margin="0,10,0,0"/>
                        <Button Text="🔗 צור רשימה ממוזגת" Command="{Binding OpenMergeModeCommand}" BackgroundColor="#F0F0F0" TextColor="#2B3A42" FontAttributes="Bold" CornerRadius="8" HeightRequest="45" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame IsVisible="{Binding IsHeaderOpen}" Padding="15,20" CornerRadius="12" BackgroundColor="White" HasShadow="True" BorderColor="Transparent" Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="15">

                        <Label Text="הגדר טווח עדכון לרשימה זו" FontAttributes="Bold" FontSize="16" TextColor="#2B3A42" HorizontalOptions="Center" />

                        <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                            <FlexLayout.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="BackgroundColor" Value="#F0F0F0"/>
                                    <Setter Property="TextColor" Value="Gray"/>
                                    <Setter Property="CornerRadius" Value="20"/>
                                    <Setter Property="HeightRequest" Value="40"/>
                                    <Setter Property="Padding" Value="15,0"/>
                                    <Setter Property="Margin" Value="5"/>
                                    <Setter Property="FontAttributes" Value="Bold"/>
                                </Style>
                            </FlexLayout.Resources>

                            <Button Text="יום אחד" Command="{Binding SelectRangeTypeCommand}" CommandParameter="Day">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="Day">
                                        <Setter Property="BackgroundColor" Value="#2B3A42" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="השבוע" Command="{Binding SelectRangeTypeCommand}" CommandParameter="Week">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="Week">
                                        <Setter Property="BackgroundColor" Value="#2B3A42" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="שבועיים" Command="{Binding SelectRangeTypeCommand}" CommandParameter="TwoWeeks">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="TwoWeeks">
                                        <Setter Property="BackgroundColor" Value="#2B3A42" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="שבוע הבא" Command="{Binding SelectRangeTypeCommand}" CommandParameter="NextWeek">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="NextWeek">
                                        <Setter Property="BackgroundColor" Value="#2B3A42" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="חודש" Command="{Binding SelectRangeTypeCommand}" CommandParameter="Month">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="Month">
                                        <Setter Property="BackgroundColor" Value="#2B3A42" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="אחר..." Command="{Binding SelectRangeTypeCommand}" CommandParameter="CustomRolling">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="CustomRolling">
                                        <Setter Property="BackgroundColor" Value="#2B3A42" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>

                        <VerticalStackLayout IsVisible="{Binding IsCustomRollingVisible}" Spacing="10" Margin="0,5">
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="התחל מעוד:" VerticalOptions="Center" TextColor="Gray" FontAttributes="Bold"/>
                                <Entry Grid.Column="1" Text="{Binding CustomOffsetDays}" Keyboard="Numeric" HorizontalTextAlignment="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="ימים" VerticalOptions="Center" TextColor="Gray"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="למשך:" VerticalOptions="Center" TextColor="Gray" FontAttributes="Bold"/>
                                <Entry Grid.Column="1" Text="{Binding CustomDurationDays}" Keyboard="Numeric" HorizontalTextAlignment="Center" Margin="10,0"/>
                                <Label Grid.Column="2" Text="ימים" VerticalOptions="Center" TextColor="Gray"/>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>
                        <Label Text="--- או ---" HorizontalOptions="Center" TextColor="LightGray" FontSize="14"/>
                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,5"/>

                        <Label Text="תאריכים ספציפיים (נעול ביומן)" FontAttributes="Bold" FontSize="16" TextColor="#2B3A42" HorizontalOptions="Center" />

                        <Button Text="בחר תאריכים 📅" Command="{Binding SelectRangeTypeCommand}" CommandParameter="SpecificDates" BackgroundColor="#F0F0F0" TextColor="Gray" CornerRadius="20" HeightRequest="40" Margin="20,0" FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedRangeType}" Value="SpecificDates">
                                    <Setter Property="BackgroundColor" Value="#2B3A42" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Grid IsVisible="{Binding IsSpecificDatesVisible}" ColumnDefinitions="*, Auto, *" ColumnSpacing="10" Margin="0,10,0,0">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="מאת:" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                <DatePicker Date="{Binding SpecificStartDate}" Format="dd/MM/yyyy" TextColor="Black" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="-" VerticalOptions="Center" FontSize="20" TextColor="Gray"/>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="עד:" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                                <DatePicker Date="{Binding SpecificEndDate}" Format="dd/MM/yyyy" TextColor="Black" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Button Grid.Column="0" Text="ביטול" Command="{Binding CancelSelectionCommand}" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
                            <Button Grid.Column="1" Text="סגור והצג" Command="{Binding ApplyAndCloseCommand}" BackgroundColor="#2B3A42" TextColor="White" CornerRadius="8" HeightRequest="45" FontAttributes="Bold"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding GroupedShoppingItems}" IsGrouped="True" Margin="20,0,20,0"
                            IsVisible="{Binding HasValidList}">
                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding IsHeaderClosed}" Value="False">
                        <Setter Property="Opacity" Value="0.2" />
                        <Setter Property="InputTransparent" Value="True" />
                    </DataTrigger>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding IsListsMenuOpen}" Value="True">
                        <Setter Property="Opacity" Value="0.2" />
                        <Setter Property="InputTransparent" Value="True" />
                    </DataTrigger>
                </CollectionView.Triggers>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Label Text="{Binding CategoryName}" FontSize="18" FontAttributes="Bold" TextColor="#2B3A42" Margin="0,15,0,5" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10,5" Margin="0,5" CornerRadius="8" HasShadow="False" BorderColor="#EEEEEE">
                            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsBought}" Color="#2B3A42" />
                                <Label Text="{Binding DisplayText}" VerticalOptions="Center" FontSize="16" TextColor="Black">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsBought}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="LightGray" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="{Binding EmptyViewText}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" FontSize="16" Margin="30" />
                </CollectionView.EmptyView>
            </CollectionView>

        </Grid>

        <Grid BackgroundColor="#99000000" IsVisible="{Binding IsMergeModeActive}">
            <Frame VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320" MaximumHeightRequest="450" CornerRadius="15" Padding="20">
                <VerticalStackLayout Spacing="15">
                    <Label Text="מיזוג רשימות 🔗" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" TextColor="#2B3A42"/>
                    <Label Text="סמן את הרשימות שברצונך לאחד:" TextColor="Gray" FontSize="14" HorizontalOptions="Center"/>

                    <ScrollView MaximumHeightRequest="250">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MergeableLists}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                                        <CheckBox IsChecked="{Binding IsSelected}" Color="#2B3A42" />
                                        <Label Text="{Binding List.Title}" VerticalOptions="Center" FontSize="16" TextColor="Black" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Button Text="בצע מיזוג" Command="{Binding ConfirmMergeCommand}" BackgroundColor="#2B3A42" TextColor="White" CornerRadius="8" HeightRequest="45" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Button Text="ביטול" Command="{Binding CancelMergeCommand}" BackgroundColor="Transparent" TextColor="Gray" HeightRequest="45" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <items:LoadingOverlayControl IsLoading="{Binding IsLoading}"
                                         LoadingText="{Binding LoadingText}"/>
    </Grid>
</ContentView>