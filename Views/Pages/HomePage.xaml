<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Recipe_book.ViewModels"
             xmlns:models="clr-namespace:Recipe_book.Models.Recipes"
             xmlns:controls="clr-namespace:Recipe_book.Views.Items"
             x:Class="Recipe_book.Views.Pages.HomePage"
             x:DataType="vm:MainViewModel"
             x:Name="HomePageRoot"
             FlowDirection="RightToLeft">

    <Grid BackgroundColor="Transparent">
        <Grid RowDefinitions="Auto, *">
            
            <Grid x:Name="SearchArea" Grid.Row="0" ColumnDefinitions=" * , Auto" Margin="15,15,20,10" ColumnSpacing="5">


                <controls:SearchBarControl x:Name="MainSearchBar"
                                           Grid.Column="0" 
                                           SearchText="{Binding SearchQuery}" 
                                           PlaceholderText="חפש מתכון..." 
                                           VerticalOptions="Center" />

                <ImageButton Grid.Column="1"
                             Source="settings_icon.svg" 
                             WidthRequest="30" 
                             HeightRequest="30"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center" />
            </Grid>

            <ScrollView x:Name="MainScroll" Grid.Row="1">
                <VerticalStackLayout Padding="20,0,20,20" Spacing="20">

                    <VerticalStackLayout IsVisible="{Binding IsSearching}" Spacing="10">
                        <Label Text="תוצאות חיפוש" FontAttributes="Bold" FontSize="18"/>
                        <CollectionView ItemsSource="{Binding Recipes}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="10" HorizontalItemSpacing="10"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Recipe">
                                    <controls:RecipeCardControl RecipeName="{Binding Title}" 
                                        RecipeImage="{Binding DisplayImage}"
                                        RecipeDescription="{Binding Description}"
                                        RecipeRating="{Binding Rating}"
                                        RecipePrepTime="{Binding PrepTime}" 
                                        RecipeServings="{Binding Servings}">
                                        <controls:RecipeCardControl.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenRecipeCommand}" CommandParameter="{Binding .}"/>
                                        </controls:RecipeCardControl.GestureRecognizers>
                                    </controls:RecipeCardControl>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsSearching, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}" Spacing="25">

                        <controls:DailyMealsControl x:Name="MealsControl" Margin="-20,0,-20,0" />

                        <VerticalStackLayout Spacing="10">
                            <Label Text="אולי הגיע הזמן להכין?" FontAttributes="Bold" FontSize="18"/>
                            <CollectionView x:Name="SuggestionsList" ItemsSource="{Binding DidntUsedForLongTime}" HeightRequest="150">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Recipe">

                                        <controls:RecipeCardControl WidthRequest="{Binding Width, Source={x:Reference HomePageRoot}, Converter={StaticResource ScreenRatioConverter}, ConverterParameter='0.85'}"
                                                                    RecipeName="{Binding Title}" 
                                                                    RecipeImage="{Binding DisplayImage}"
                                                                    RecipeDescription="{Binding Description}"
                                                                    RecipeRating="{Binding Rating}"
                                                                    RecipePrepTime="{Binding PrepTime}" 
                                                                    RecipeServings="{Binding Servings}">

                                            <controls:RecipeCardControl.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenRecipeCommand}" CommandParameter="{Binding .}"/>
                                            </controls:RecipeCardControl.GestureRecognizers>
                                        </controls:RecipeCardControl>

                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <controls:FloatingActionControl 
                    Grid.Row="1"
                    IconSource="recipe_plus_icon.svg" 
                    ButtonColor="{StaticResource Primary}"
                    TextColor="White"
                    ButtonSize="50"
                    IconSize="28"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20,10,20,10"
                    Command="{Binding AddRecipeCommand}" />

        </Grid>
    </Grid>
</ContentView>