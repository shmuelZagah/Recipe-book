<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipe_book.Views.Items.CustomBottomNavControl"
             x:Name="ThisControl">

        <Grid HeightRequest="100" VerticalOptions="End" FlowDirection="RightToLeft">


            <GraphicsView x:Name="NavBarGraphics"
                      HeightRequest="100"
                      VerticalOptions="End"
                      Drawable="{Binding Source={x:Reference ThisControl}, Path=NavDrawable}"/>


            <Grid x:Name="TabsGrid" 
              ColumnDefinitions="*, *, *, *" 
              HeightRequest="100"
              VerticalOptions="End"
              Margin="0,0,0,0">

                <!-- Tab 0 - Home -->
                <Grid Grid.Column="0" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0"/>
                    </Grid.GestureRecognizers>
                    <Image x:Name="Tab0Icon" 
                       Source="home_icon.svg" 
                       WidthRequest="28" 
                       HeightRequest="28" 
                       HorizontalOptions="Center" 
                       VerticalOptions="End"
                       Margin="0,0,0,16"/>
                </Grid>

                <!-- Tab 1 - Library -->
                <Grid Grid.Column="1" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1"/>
                    </Grid.GestureRecognizers>
                    <Image x:Name="Tab1Icon" 
                       Source="menu_book_icon.svg" 
                       WidthRequest="28" 
                       HeightRequest="28" 
                       HorizontalOptions="Center" 
                       VerticalOptions="End"
                       Margin="0,0,0,16"/>
                </Grid>

                <!-- Tab 2 - Schedule -->
                <Grid Grid.Column="2" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2"/>
                    </Grid.GestureRecognizers>
                    <Image x:Name="Tab2Icon" 
                       Source="calendar_meal_icon.svg" 
                       WidthRequest="28" 
                       HeightRequest="28" 
                       HorizontalOptions="Center" 
                       VerticalOptions="End"
                       Margin="0,0,0,16"/>
                </Grid>

                <!-- Tab 3 - Shopping -->
                <Grid Grid.Column="3" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3"/>
                    </Grid.GestureRecognizers>
                    <Image x:Name="Tab3Icon" 
                       Source="list_alt_icon.svg" 
                       WidthRequest="28" 
                       HeightRequest="28" 
                       HorizontalOptions="Center" 
                       VerticalOptions="End"
                       Margin="0,0,0,16"/>
                </Grid>

            </Grid>
        </Grid>
    </ContentView>
