<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipe_book.Views.Items.SearchBarControl"
             x:Name="ThisControl">

    <Border x:Name="SearchBorder"
            StrokeShape="RoundRectangle 25"
            StrokeThickness="0" 
            BackgroundColor="Transparent"
            HorizontalOptions="End"
            WidthRequest="50"
            HeightRequest="50"
            Padding="0">

        <!-- באג 1: הוספת BackgroundColor="Transparent" לגריד -->
        <Grid ColumnDefinitions="Auto, *"
              BackgroundColor="Transparent">

            <Image x:Name="ActionIcon"
                   Grid.Column="0"
                   Source="search_icon.svg"
                   WidthRequest="26"
                   HeightRequest="26"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="12,0,0,0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnToggleSearchClicked"/>
                </Image.GestureRecognizers>
            </Image>

            <Entry x:Name="SearchInput"
                   Grid.Column="1"
                   Placeholder="{Binding PlaceholderText, Source={x:Reference ThisControl}}"
                   Text="{Binding SearchText, Source={x:Reference ThisControl}}"
                   IsVisible="False"
                   Opacity="0"
                   BackgroundColor="Transparent"
                   VerticalOptions="Center"
                   Margin="10,0,10,0"
                   Completed="OnSearchCompleted"
                   Unfocused="OnSearchInputUnfocused"/>
        </Grid>
    </Border>

</ContentView>
