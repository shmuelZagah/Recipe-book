<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipe_book.Views.Items.ShoppingListsBottomSheet"
             FlowDirection="RightToLeft">

    <Grid x:Name="BottomSheetOverlay" IsVisible="False" BackgroundColor="Transparent">

        <BoxView x:Name="BottomSheetDim" BackgroundColor="#80000000" Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="BottomSheetContainer" 
                VerticalOptions="End" 
                BackgroundColor="White" 
                StrokeThickness="0" 
                Padding="20,15,20,30" 
                TranslationY="800">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25,25,0,0" />
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnBottomSheetPanUpdated" />
            </Border.GestureRecognizers>

           <VerticalStackLayout Spacing="10">
                <BoxView HeightRequest="5" WidthRequest="40" CornerRadius="2.5" BackgroundColor="#E0E0E0" HorizontalOptions="Center" Margin="0,0,0,5" />

                <Label Text="שלדים לרשימות (תבניות בסיס)" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Start" Margin="5,5,0,2"/>
                
                <CollectionView ItemsSource="{Binding AbstractLists}" MaximumHeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15,10" Margin="0,4" CornerRadius="8" BackgroundColor="#F1F3F5" BorderColor="Transparent" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.CreateListFromTemplateCommand, Source={x:Reference BottomSheetOverlay}}" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto, Auto" VerticalOptions="Center">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Image Source="lock_simple_icon.svg" WidthRequest="16" HeightRequest="16" Opacity="0.5" VerticalOptions="Center"/>
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#495057" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    
                                    <ImageButton Grid.Column="1" 
                                                 Source="pencil_light_withline_icon.svg" 
                                                 WidthRequest="20" HeightRequest="20" 
                                                 BackgroundColor="Transparent" 
                                                 Margin="0,0,15,0"
                                                 Command="{Binding BindingContext.SwitchToTemplateEditCommand, Source={x:Reference BottomSheetOverlay}}" 
                                                 CommandParameter="{Binding .}" />
                                                 
                                    <ImageButton Grid.Column="2" 
                                                 Source="minus_icon.svg" 
                                                 WidthRequest="20" HeightRequest="20" 
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding BindingContext.DeleteTemplateCommand, Source={x:Reference BottomSheetOverlay}}" 
                                                 CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="אין שלדים שמורים כרגע" FontSize="13" TextColor="Gray" HorizontalOptions="Center" Margin="10"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,2"/>

                <Label Text="רשימות קניות פעילות" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" HorizontalOptions="Start" Margin="5,5,0,2"/>

                <CollectionView ItemsSource="{Binding SavedLists}" MaximumHeightRequest="180">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="15,10" Margin="0,4" CornerRadius="8" BackgroundColor="#F8F9FA" BorderColor="Transparent" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SwitchListCommand, Source={x:Reference BottomSheetOverlay}}" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*, Auto, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#2B3A42" VerticalOptions="Center" />
                                    <ImageButton Grid.Column="1" 
                                                 Source="pencil_light_withline_icon.svg" 
                                                 WidthRequest="22" HeightRequest="22" 
                                                 BackgroundColor="Transparent" 
                                                 Margin="0,0,15,0"
                                                 Command="{Binding BindingContext.RenameListCommand, Source={x:Reference BottomSheetOverlay}}" 
                                                 CommandParameter="{Binding .}" />
                                    <ImageButton Grid.Column="2" 
                                                 Source="minus_icon.svg" 
                                                 WidthRequest="22" HeightRequest="22" 
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding BindingContext.DeleteListCommand, Source={x:Reference BottomSheetOverlay}}" 
                                                 CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,5">
                    <Frame Grid.Column="0" Padding="10" CornerRadius="8" BackgroundColor="Transparent" BorderColor="#EEEEEE" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateNewTemplateCommand}" />
                        </Frame.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="+" FontSize="16" TextColor="Gray" VerticalOptions="Center" />
                            <Label Text="שלד חדש" FontSize="13" TextColor="Gray" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>

                    <Frame Grid.Column="1" Padding="10" CornerRadius="8" BackgroundColor="Transparent" BorderColor="#EEEEEE" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateNewListCommand}" />
                        </Frame.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="+" FontSize="16" TextColor="Gray" VerticalOptions="Center" />
                            <Label Text="רשימה חדשה" FontSize="13" TextColor="Gray" FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Frame>
                </Grid>

                <Button Text="מיזוג רשימות פעילות" 
                        Command="{Binding BindingContext.OpenMergeModeCommand, Source={x:Reference BottomSheetOverlay}}" 
                        BackgroundColor="Transparent" 
                        TextColor="Black" 
                        BorderColor="Black" 
                        BorderWidth="1"
                        FontAttributes="Bold" 
                        CornerRadius="8" 
                        HeightRequest="42" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>