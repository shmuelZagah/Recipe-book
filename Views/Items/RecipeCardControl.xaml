<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipe_book.Views.Items.RecipeCardControl"
             x:Name="this">
    
    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="0"
            BackgroundColor="White"
            WidthRequest="140"
            HeightRequest="150"
            Margin="5"
            Shadow="{Shadow Brush=Black, Offset='0,2', Opacity=0.1}">

        <Grid RowDefinitions="*, Auto">
            <Image Grid.Row="0"
                   Source="{Binding RecipeImage, Source={x:Reference this}}"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
            </Image>

            <Label Grid.Row="1"
                   Text="{Binding RecipeName, Source={x:Reference this}}"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#333"
                   Padding="8,5"
                   HorizontalOptions="Start"
                   MaxLines="1"
                   LineBreakMode="TailTruncation"/>
        </Grid>
    </Border>
</ContentView>
