<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipe_book.Views.SubPages.RecipeViewerPage"
             xmlns:vm="clr-namespace:Recipe_book.ViewModels"
             xmlns:models="clr-namespace:Recipe_book.Models.Recipes"
             xmlns:items="clr-namespace:Recipe_book.Views.Items"
             Title="{Binding CurrentRecipe.Title}"
             FlowDirection="RightToLeft"
             BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="ערוך מתכון" 
                     Command="{Binding EditRecipeCommand}" 
                     Order="Secondary" />

        <ToolbarItem Text="ניהול תיקיות" 
                     Command="{Binding OpenFolderSelectionCommand}" 
                     Order="Secondary" />

        <ToolbarItem Text="מחק מתכון" 
                     Command="{Binding DeleteRecipeCommand}" 
                     Order="Secondary" />

        <ToolbarItem Text="הוסף לארוחה" 
             Command="{Binding OpenScheduleOverlayCommand}"
             Order="Secondary" />

        <ToolbarItem Text="שתף" 
                     Command="{Binding ShareRecipeCommand}" 
                     Order="Secondary" 
                        />

    </ContentPage.ToolbarItems>
    <Grid>

        <ScrollView x:Name="OuterScroll"
                    Scrolled="OnOuterScroll">

            <VerticalStackLayout>

                <VerticalStackLayout x:Name="HeaderSection">
                    <Grid HeightRequest="200">
                        <Image Source="{Binding CurrentRecipe.DisplayImage}"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"/>



                        <BoxView VerticalOptions="End" HeightRequest="60" Color="Black" Opacity="0.5"/>
                        <Grid VerticalOptions="End" HeightRequest="60" Padding="15,0" ColumnDefinitions="*, Auto">

                            <Label Grid.Column="0" 
                                   Text="{Binding CurrentRecipe.Title}"
                                   TextColor="White"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />

                            <Grid Grid.Column="1" VerticalOptions="Center" Padding="10,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                </Grid.GestureRecognizers>

                                <Label Text="♡" 
                                       FontSize="32" 
                                       TextColor="White" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       IsVisible="{Binding CurrentRecipe.IsFavorite, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}" />

                                <Label Text="❤️" 
                                       FontSize="24" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       IsVisible="{Binding CurrentRecipe.IsFavorite}" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <VerticalStackLayout Padding="15" BackgroundColor="#F0F0F0">
                        <Label Text="{Binding CurrentRecipe.Description}"
                               TextColor="Black"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TabsSection" BackgroundColor="LightGray" >
                    <Grid ColumnDefinitions="*,*" HeightRequest="50">
                        <Button Grid.Column="0"
                                CornerRadius="0"
                                Text="מצרכים"
                                TextColor="Black"
                                FontSize="18"
                                FontAttributes="Bold"
                                Command="{Binding ShowIngredientsCommand}"
                                BackgroundColor="{Binding IsIngredientsMode, Converter={StaticResource BoolToColor}}"/>

                        <Button Grid.Column="1"
                                CornerRadius="0"
                                Text="אופן ההכנה"
                                TextColor="Black"
                                FontSize="18"
                                FontAttributes="Bold"
                                Command="{Binding ShowStepsCommand}"
                                BackgroundColor="{Binding IsIngredientsMode,
                                Converter={StaticResource BoolToColor}, ConverterParameter='Invert'}"/>
                    </Grid>
                </VerticalStackLayout>



                <Grid>
                    <ScrollView x:Name="IngredientsInnerScroll" Background="LightGray"
                                IsVisible="{Binding IsIngredientsMode}"
                                Scrolled="OnInnerScroll">
                        <VerticalStackLayout Padding="20">
                            <StackLayout BindableLayout.ItemsSource="{Binding IngredientsList}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Ingredient">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Margin="10,0,0,0"
                                                StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="Auto, *">

                                                <CheckBox Grid.Column="0" Color="#0570A0"/>

                                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">

                                                    <Label Text="{Binding Quantity}" FontAttributes="Bold" FontSize="16" TextColor="Black"/>

                                                    <Label Text="{Binding Unit}" FontSize="16" TextColor="Black"/>

                                                    <Label Text="{Binding Name}" FontSize="16" TextColor="Black"/>

                                                </HorizontalStackLayout>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- שלבים -->
                    <ScrollView x:Name="StepsInnerScroll" Background="LightGray"
                                IsVisible="{Binding IsIngredientsMode, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}"
                                Scrolled="OnInnerScroll">
                        <VerticalStackLayout Padding="20">
                            <StackLayout BindableLayout.ItemsSource="{Binding StepsList}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecipeStep">

                                        <Grid ColumnDefinitions="40, *" Margin="0,0,0,15">
                                            <Border Grid.Column="0" Stroke="#0570A0" StrokeThickness="2" 
                                                HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15"
                                                VerticalOptions="Start" HorizontalOptions="Start" Margin="0,4,0,0">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeViewerViewModel}}, Path=ToggleStepCompleteCommand}" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="#0570A0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding StepNumber}" FontSize="14" FontAttributes="Bold" TextColor="#0570A0"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           IsVisible="{Binding IsCompleted, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}"/>
                                                    <Label Text="✓" FontSize="18" FontAttributes="Bold" TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                            IsVisible="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>

                                            <Label Grid.Column="1" Text="{Binding Description}" FontSize="16" TextColor="Black"
                                                     LineBreakMode="WordWrap" VerticalOptions="Center">
                                                <Label.Style>
                                                    <Style TargetType="Label">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Label.Style>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>


                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#80000000" 
              IsVisible="{Binding IsScheduleOverlayVisible}"
              ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseScheduleOverlayCommand}" />
            </Grid.GestureRecognizers>

            <Frame VerticalOptions="Center" 
                   HorizontalOptions="Center" 
                   BackgroundColor="White"
                   CornerRadius="15"
                   Padding="25"
                   HasShadow="True"
                   WidthRequest="320">

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer />
                </Frame.GestureRecognizers>

                <VerticalStackLayout Spacing="20">

                    <Label Text="מתי בא לך להכין את זה?"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="בחר תאריך:" FontSize="14" TextColor="Gray" />
                            <DatePicker Date="{Binding SelectedScheduleDate}"
                                        Format="dd/MM/yyyy"
                                        HorizontalOptions="Fill" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="ארוחה:" FontSize="14" TextColor="Gray" />
                            <Picker ItemsSource="{Binding AvailableMeals}"
                                    SelectedItem="{Binding SelectedMealType}"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="קיצורי דרך:" FontSize="14" TextColor="Gray" />

                            <FlexLayout BindableLayout.ItemsSource="{Binding DateShortcuts}" 
                                        Wrap="Wrap" 
                                        Direction="Row" 
                                        JustifyContent="Center">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Button Text="{Binding Name}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeViewerViewModel}}, Path=ApplyShortcutCommand}"
                                                CommandParameter="{Binding Date}"
                                                BackgroundColor="#F0F0F0"
                                                TextColor="Black"
                                                CornerRadius="10"
                                                HeightRequest="35"
                                                Padding="15,0"
                                                Margin="0,0,5,5" 
                                                FontSize="13"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                            <Button Grid.Column="0" 
                                    Text="ביטול" 
                                    BackgroundColor="Transparent"
                                    TextColor="Gray"
                                    FontAttributes="Bold"
                                    Command="{Binding CloseScheduleOverlayCommand}"/>

                            <Button Grid.Column="1" 
                                    Text="שמור" 
                                    BackgroundColor="#0570A0"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Command="{Binding SaveScheduleCommand}"/>
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </Grid>
        
        <items:LoadingOverlayControl IsLoading="{Binding IsLoading}" 
                                     LoadingText="{Binding LoadingText}" />
    </Grid>
</ContentPage>
    
    
