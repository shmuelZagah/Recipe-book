<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Recipe_book.Views.SubPages.RecipeEditorPage"
             xmlns:vm="clr-namespace:Recipe_book.ViewModels"
             xmlns:models="clr-namespace:Recipe_book.Models.Recipes"
             xmlns:behaviors="clr-namespace:Recipe_book.Helpers.Behaviors"
             FlowDirection="RightToLeft"
             x:Name="RecipeEditor"
             BackgroundColor="LightGray">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="שמור" Order="Primary" Command="{Binding SaveRecipeCommand}"/>
        <ToolbarItem Text="מחק מתכון" Order="Secondary" Command="{Binding DeleteRecipeCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>

        <DataTemplate x:Key="RecipeHeaderTemplate">
            <VerticalStackLayout Spacing="10" Padding="0,20,0,0" BackgroundColor="White">
                <Grid BackgroundColor="AliceBlue" RowDefinitions="Auto, Auto, Auto" Padding="10" Margin="0,30,0,0">
                    <Border Grid.Row="0" StrokeShape="RoundRectangle 20" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="Black" Margin="0,-50,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeImageCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image Source="{Binding RecipeImage}" Aspect="AspectFill"/>
                            <Label Text="הוסף תמונה" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Grid.Row="2" Spacing="5">
                        <BoxView Color="Gray" WidthRequest="250" HeightRequest="1" HorizontalOptions="Center" Opacity="0.3" />
                        <Entry Placeholder="הוסף שם" Text="{Binding RecipeTitle}" FontSize="26" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="Black" PlaceholderColor="#555" BackgroundColor="Transparent"/>
                        <Entry Placeholder="הוסף תיאור" Text="{Binding RecipeDescription}" FontSize="15" HorizontalTextAlignment="Center" TextColor="Black" PlaceholderColor="#555" BackgroundColor="Transparent" />

                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,10,0,0">
                            <Entry Placeholder="זמן הכנה (למשל: 45 דק')" Text="{Binding PrepTime}" FontSize="14" HorizontalTextAlignment="Center" TextColor="Black" BackgroundColor="Transparent" WidthRequest="150"/>
                            <BoxView Color="Gray" WidthRequest="1" HeightRequest="20" VerticalOptions="Center" Opacity="0.3"/>
                            <Entry Placeholder="כמות (למשל: 4 מנות)" Text="{Binding Servings}" FontSize="14" HorizontalTextAlignment="Center" TextColor="Black" BackgroundColor="Transparent" WidthRequest="150"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <Grid Margin="0,-20,0,0" HeightRequest="50" ColumnDefinitions="*,Auto,*">
                    <Button Grid.Column="0" CornerRadius="0" Text="מצרכים" TextColor="Black" FontSize="18" FontAttributes="Bold" Command="{Binding ShowIngredientsCommand}" BackgroundColor="{Binding IsIngredientsMode, Converter={StaticResource BoolToColor}}"/>
                    <BoxView Grid.Column="1" Color="Black" WidthRequest="3" HorizontalOptions="Center" HeightRequest="50" Margin="0,0,0,0"/>
                    <Button Grid.Column="2" CornerRadius="0" Text="שלבי בישול" TextColor="Black" FontSize="18" FontAttributes="Bold" Command="{Binding ShowStepsCommand}" BackgroundColor="{Binding IsIngredientsMode, Converter={StaticResource BoolToColor}, ConverterParameter='Invert'}"/>
                </Grid>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="IngredientsFooterTemplate">
            <Grid Padding="20,0,20,0" Margin="0,5,0,20" HeightRequest="40" ColumnDefinitions="Auto, *">
                <ImageButton Grid.Column="0" Source="add_circle_icon.svg" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" HorizontalOptions="Start" Command="{Binding AddIngredientCommand}">
                    <ImageButton.Shadow>
                        <Shadow Brush="Black" Offset="1,1" Opacity="0.2" Radius="3"/>
                    </ImageButton.Shadow>
                </ImageButton>
                <Label Grid.Column="1" Text="הוסף מצרך..." TextColor="Black" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddIngredientCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StepsFooterTemplate">
            <Grid Padding="20,0,20,0" Margin="0,5,0,20" HeightRequest="40" ColumnDefinitions="Auto, *">
                <ImageButton Grid.Column="0" Source="add_circle_icon.svg" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" HorizontalOptions="Start" Command="{Binding AddStepCommand}">
                    <ImageButton.Shadow>
                        <Shadow Brush="Black" Offset="1,1" Opacity="0.2" Radius="3"/>
                    </ImageButton.Shadow>
                </ImageButton>
                <Label Grid.Column="1" Text="הוסף שלב..." TextColor="Black" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddStepCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </DataTemplate>

    </ContentPage.Resources>

    <Grid>

        <CollectionView ItemsSource="{Binding IngredientsList}" 
                        IsVisible="{Binding IsIngredientsMode}"
                        Header="{Binding .}" HeaderTemplate="{StaticResource RecipeHeaderTemplate}"
                        Footer="{Binding .}" FooterTemplate="{StaticResource IngredientsFooterTemplate}"
                        CanReorderItems="True"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Ingredient">
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent" Padding="5" Margin="20,0,20,8" HeightRequest="45">
                        <Grid ColumnDefinitions="60, 90, *, Auto">
                            <Entry Grid.Column="0" Text="{Binding Quantity}" PlaceholderColor="Black" Keyboard="Numeric" HorizontalTextAlignment="Center" BackgroundColor="Transparent" Placeholder="0" VerticalOptions="Center">
                                <Entry.Behaviors>
                                    <behaviors:NumericValidationBehavior />
                                </Entry.Behaviors>
                            </Entry>
                            <Picker Grid.Column="1" ItemsSource="{Binding Source={x:Reference RecipeEditor}, Path=BindingContext.AvailableUnits}" SelectedItem="{Binding Unit}" HorizontalTextAlignment="Center" BackgroundColor="Transparent" VerticalOptions="Center" />
                            <Entry Grid.Column="2" PlaceholderColor="Black" Text="{Binding Name}" Placeholder="שם המצרך" BackgroundColor="Transparent" VerticalOptions="Center"/>
                            <ImageButton Grid.Column="3" Source="cancel_icon.svg" HeightRequest="25" WidthRequest="25" Opacity="0.5" VerticalOptions="Center" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditorViewModel}}, Path=RemoveIngredientCommand}" CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView ItemsSource="{Binding StepsList}" 
                        IsVisible="{Binding IsIngredientsMode, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}"
                        Header="{Binding .}" HeaderTemplate="{StaticResource RecipeHeaderTemplate}"
                        Footer="{Binding .}" FooterTemplate="{StaticResource StepsFooterTemplate}"
                        CanReorderItems="True"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RecipeStep">
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="Transparent" Padding="5" Margin="20,0,20,8">
                        <Grid ColumnDefinitions="30, *, Auto, Auto">
                            <Label Grid.Column="0" Text="{Binding StepNumber, StringFormat='{0}.'}" FontSize="16" TextColor="Black" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,10,0,0"/>

                            <Editor Grid.Column="1" Text="{Binding Description}" Placeholder="תיאור השלב" PlaceholderColor="Black" TextColor="Black" BackgroundColor="Transparent" FontSize="16" HeightRequest="60" VerticalOptions="Start"/>

                            <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Stroke="Black" StrokeThickness="1" Padding="8,2" Margin="5,5" VerticalOptions="Start" HeightRequest="30">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditorViewModel}}, Path=ToggleOptionalStepCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="רשות" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOptional}" Value="True">
                                                    <Setter Property="TextColor" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOptional}" Value="True">
                                                <Setter Property="BackgroundColor" Value="Black"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ImageButton Grid.Column="3" Source="cancel_icon.svg" HeightRequest="25" WidthRequest="25" Opacity="0.5" VerticalOptions="Start" Margin="0,8,0,0" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecipeEditorViewModel}}, Path=RemoveStepCommand}" CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>