<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Recipe_book.Views.Items"
             x:Class="Recipe_book.MainPage"
             Shell.NavBarIsVisible="False"
             xmlns:barControls="clr-namespace:Recipe_book.Views.Items.bars"
             xmlns:Layouts="clr-namespace:Recipe_book.Views.Layouts">

    <Grid RowDefinitions="*, 90">

        <Grid Grid.Row="0" IsClippedToBounds="True" BackgroundColor="#F5F5F5">
            <Layouts:SwipeInterceptView x:Name="SwipeLayer" HorizontalOptions="Fill" VerticalOptions="Fill" FlowDirection="LeftToRight">
                <Grid x:Name="PagesContainer" HorizontalOptions="Fill" VerticalOptions="Fill" />
            </Layouts:SwipeInterceptView>
        </Grid>

        <barControls:LiquidBottomBar x:Name="BottomBar" Grid.Row="1" TabSelected="OnTabSelected" />

        <controls:ShoppingListsBottomSheet x:Name="GlobalBottomSheet" Grid.RowSpan="2" ZIndex="100" />

    </Grid>
</ContentPage>