<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Recipe_book.Views.Items"
             x:Class="Recipe_book.MainPage"
             Shell.NavBarIsVisible="False"
             xmlns:barControls="clr-namespace:Recipe_book.Views.Items.bars"
             >

    <Grid RowDefinitions="*, 90">

        <Grid x:Name="ContentHost" Grid.Row="0" IsClippedToBounds="True" />

        <barControls:LiquidBottomBar x:Name="BottomBar" Grid.Row="1" TabSelected="OnTabSelected" />

    </Grid>

</ContentPage>